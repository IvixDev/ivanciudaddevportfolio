---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import onestLatin from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";
import bricolageLatin from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import type { InfoSeoProps } from "../types/types";
import { getLang, getMessages, getOppositeLocaleUrl } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  infoSeo: InfoSeoProps;
}

const SITE = "https://www.ivanciudad.com";

const { infoSeo } = Astro.props;
const path = Astro.url.pathname;
const lang = getLang(Astro.currentLocale);
const m = getMessages(lang);

// Alternates recíprocos: la ruta equivalente en el otro idioma sale de la tabla `nav`.
const normalize = (value: string) => (value.length > 1 ? value.replace(/\/$/, "") : value);
const currentUrl = normalize(path);
const otherUrl = normalize(getOppositeLocaleUrl(path, lang));
const toAbsolute = (value: string) => `${SITE}${value === "/" ? "" : value}`;
const esUrl = toAbsolute(lang === "es" ? currentUrl : otherUrl);
const enUrl = toAbsolute(lang === "en" ? currentUrl : otherUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta
      name="google-site-verification"
      content="rtqz__fHq7l_eMEEl-ULln50aHX17BLq7dSVgfVkLdU"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />

    <!-- Hreflang Tags for SEO -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <ClientRouter />

    <!-- Color crítico: evita el frame blanco antes de cargar el CSS -->
    <style is:inline>
      :root {
        background-color: #0B1120;
        color-scheme: dark;
      }

      /* Bloqueo de transiciones durante la carga/navegación */
      .no-transitions *,
      .no-transitions *::before,
      .no-transitions *::after {
        transition: none !important;
        animation: none !important;
      }
    </style>

    <script is:inline>
      // Ciclo de vida de View Transitions
      document.addEventListener("astro:before-swap", () => {
        document.documentElement.classList.add("no-transitions");
      });

      document.addEventListener("astro:page-load", () => {
        // Doble rAF: reactiva las transiciones una vez pintado el nuevo estado
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.documentElement.classList.remove("no-transitions");
          });
        });
      });
    </script>

    <SEO {...infoSeo} />
    <SpeedInsights />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col bg-ink text-fg selection:bg-brand/30 selection:text-fg">
    <a class="skip-link" href="#contenido">{m.a11y.skip_to_content}</a>
    <SiteHeader currentPath={path} />
    <main id="contenido" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
