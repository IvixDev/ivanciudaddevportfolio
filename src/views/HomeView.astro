---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import TechMarquee from "../components/home/TechMarquee.astro";
import ProjectsSection from "../components/home/ProjectsSection.astro";
import NowSection from "../components/home/NowSection.astro";
import AboutSection from "../components/home/AboutSection.astro";
import ContactBlock from "../components/home/ContactBlock.astro";
import { seoMapper } from "../helpers/seo.helper";
import { buildPersonSchema, buildWebsiteSchema } from "../helpers/schema.helper";
import { getLang, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale;
const t = useTranslations(lang);

const url = lang === "en" ? "https://www.ivanciudad.com/en" : "https://www.ivanciudad.com";
const infoSeo = seoMapper(t("home.title"), t("home.description"), url, t("home.image_url"), t("home.image_alt"), undefined, getLang(lang));

const schemas = [buildPersonSchema(t), buildWebsiteSchema(t)];
---

<Layout infoSeo={infoSeo}>
  {
    schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }
  <HomeHero />
  <TechMarquee />
  <ProjectsSection />
  <NowSection />
  <AboutSection />
  <ContactBlock />
</Layout>
