---
import Layout from "../layouts/Layout.astro";
import GradientText from "../components/ui/GradientText.astro";
import ProjectFilter from "../components/projects/ProjectFilter.astro";
import ProjectRow from "../components/projects/ProjectRow.astro";
import IdeaBlock from "../components/projects/IdeaBlock.astro";
import { getLocalizedProjects } from "../content/projects";
import { seoMapper } from "../helpers/seo.helper";
import { buildBreadcrumbSchema, buildProjectsPageSchema } from "../helpers/schema.helper";
import { format, getLang, getMessages, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale;
const t = useTranslations(lang);
const m = getMessages(lang).projects;
const items = getLocalizedProjects(lang);

const infoSeo = seoMapper(t("projects.title"), t("projects.description"), t("projects.url"), t("projects.image_url"), t("projects.image_alt"), undefined, getLang(lang));

const schemas = [buildProjectsPageSchema(t, lang), buildBreadcrumbSchema(t, "projects")];
---

<Layout infoSeo={infoSeo}>
  {
    schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }
  <div class="mx-auto w-full max-w-(--container-content) px-4 tablet:px-8 desktop:px-[clamp(16px,4vw,40px)]">
    <section class="flex flex-col gap-[18px] pt-9 pb-7 tablet:gap-[22px] tablet:pt-16 tablet:pb-10 laptop:gap-6 laptop:pt-[clamp(56px,7vw,96px)] laptop:pb-12">
      <p
        data-project-count
        aria-live="polite"
        class="animate-up font-mono text-xs text-brand tablet:text-[13px]"
      >
        {format(m.eyebrow, { count: items.length })}
      </p>
      <h1
        class="animate-up font-display text-[46px] leading-none font-extrabold tracking-[-0.035em] text-fg tablet:text-[72px] tablet:leading-[0.98] laptop:text-[clamp(46px,6.4vw,90px)]"
        style="animation-delay: 100ms"
      >
        {m.heading_before}<GradientText>{m.heading_highlight}</GradientText>{m.heading_after}
      </h1>
      <p
        class="animate-up max-w-[620px] text-[17px] text-muted tablet:text-[19px] laptop:text-[clamp(17px,1.5vw,20px)]"
        style="animation-delay: 200ms"
      >
        <span class="tablet:hidden">{m.intro_short}</span>
        <span class="hidden tablet:inline">{m.intro}</span>
      </p>
      <ProjectFilter />
    </section>

    <section aria-label={m.list_label} class="flex flex-col gap-[18px] tablet:gap-6 laptop:gap-7">
      {items.map((project, index) => <ProjectRow project={project} index={index} priority={index === 0} />)}
    </section>

    <IdeaBlock />
  </div>
</Layout>
