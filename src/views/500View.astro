---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale;
const t = useTranslations(lang);

const title = t("error_500.title");
const description = t("error_500.description");
const url = t("error_500.url");
const image = t("error_500.image");

// Páginas de error: sin indexar y sin handles de redes.
const infoSeo = {
  title,
  description,
  canonical: url,
  openGraph: {
    basic: {
      title,
      type: "website",
      image,
      url,
    },
  },
  twitter: {
    title,
    description,
    image,
  },
  extend: {
    link: [{ rel: "icon", href: "/favicon.svg" }],
    meta: [{ name: "robots", content: "noindex" }],
  },
};
---

<Layout infoSeo={infoSeo}>
  <section
    class="mx-auto flex w-full max-w-(--container-content) flex-col items-start gap-5 px-4 py-20 tablet:gap-6 tablet:px-8 tablet:py-28 desktop:px-[clamp(16px,4vw,40px)] laptop:py-[clamp(96px,10vw,160px)]"
  >
    <h1
      class="animate-up font-display text-[42px] leading-none font-extrabold tracking-[-0.035em] text-fg tablet:text-[68px] laptop:text-[clamp(46px,6.4vw,90px)]"
    >
      {t("error_500.heading")}
    </h1>
    <p
      class="animate-up max-w-[620px] text-[17px] text-muted tablet:text-[19px] laptop:text-[clamp(17px,1.5vw,20px)]"
      style="animation-delay: 100ms"
    >
      {t("error_500.body")}
    </p>
    <div class="animate-up pt-2" style="animation-delay: 200ms">
      <Button href={t("error_500.home_url")} variant="primary">{t("error_500.return_home")}</Button>
    </div>
  </section>
</Layout>
