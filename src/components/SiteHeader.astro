---
import { IconMenu2, IconX } from "@tabler/icons-react";
import Logo from "./ui/Logo.astro";
import Button from "./ui/Button.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import { headerLinks } from "../content/layout.consts";
import { getLang, getMessages, isNavActive } from "../i18n/utils";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const lang = getLang(Astro.currentLocale);
const m = getMessages(lang);

const links = headerLinks.map(({ tKey }) => {
  const href = m.nav[`${tKey}_url`];
  const isHome = tKey === "home";
  return { tKey, href, label: m.header[tKey], active: isNavActive(currentPath, href, isHome) };
});
const contactHref = `${m.nav.home_url}#contacto`;

const linkBase =
  "inline-flex min-h-11 items-center rounded-full px-4 text-[15px] font-medium transition-colors duration-(--duration-fast)";
---

<header class="sticky top-0 z-40 border-b border-line-subtle bg-ink">
  <div class="mx-auto flex h-[72px] w-full max-w-(--container-content) items-center justify-between gap-4 px-4 tablet:px-8 desktop:px-[clamp(16px,4vw,40px)]">
    <a
      href={m.nav.home_url}
      aria-label={m.a11y.home_link}
      class="inline-flex min-h-11 items-center text-brand"
    >
      <Logo animated class="size-8" />
    </a>

    <nav aria-label={m.a11y.main_nav} class="hidden tablet:block">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.active ? "page" : undefined}
                class={`${linkBase} ${link.active ? "bg-surface text-fg" : "text-muted hover:text-fg"}`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 tablet:flex">
      <LanguageSwitch currentPath={currentPath} />
      <Button href={contactHref} variant="primary" class="!py-2.5">{m.header.contact}</Button>
    </div>

    <div class="flex items-center gap-1 tablet:hidden">
      <LanguageSwitch variant="compact" currentPath={currentPath} />
      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="menu-panel"
        aria-label={m.a11y.menu_open}
        data-label-open={m.a11y.menu_open}
        data-label-close={m.a11y.menu_close}
        class="inline-flex size-11 items-center justify-center rounded-full text-muted transition-colors duration-(--duration-fast) hover:bg-surface hover:text-fg"
      >
        <span data-icon="open"><IconMenu2 size={24} stroke={1.8} aria-hidden="true" /></span>
        <span data-icon="close" class="hidden"><IconX size={24} stroke={1.8} aria-hidden="true" /></span>
      </button>
    </div>
  </div>

  <div id="menu-panel" hidden class="border-t border-line-subtle bg-ink px-4 pb-6 pt-2 tablet:hidden">
    <nav aria-label={m.a11y.main_nav}>
      <ul class="flex flex-col gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.active ? "page" : undefined}
                class={`${linkBase} w-full text-lg ${link.active ? "bg-surface text-fg" : "text-muted hover:text-fg"}`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Button href={contactHref} variant="primary" class="mt-4 w-full justify-center">{m.header.contact}</Button>
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
    const panel = document.querySelector<HTMLElement>("#menu-panel");
    if (!toggle || !panel) return;

    const openIcon = toggle.querySelector("[data-icon='open']");
    const closeIcon = toggle.querySelector("[data-icon='close']");

    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "",
      );
      panel.hidden = !open;
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
      if (!open && returnFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => setOpen(panel.hidden));

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && !panel.hidden) setOpen(false, true);
    };
    panel.addEventListener("keydown", onKeydown);
    toggle.addEventListener("keydown", onKeydown);

    // Al pasar a tablet/escritorio el panel deja de aplicar: se restablece el estado.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
</script>
