---
import SectionHeader from "../ui/SectionHeader.astro";
import { getMessages } from "../../i18n/utils";

const a = getMessages(Astro.currentLocale).about;
const favorites = a.favorites;
---

<section aria-labelledby="fav-title">
  <div data-favorites class="group flex flex-col gap-4 tablet:gap-5.5 laptop:gap-7">
    <div
      class="flex flex-col gap-4 tablet:gap-5.5 laptop:flex-row laptop:flex-wrap laptop:items-end laptop:justify-between laptop:gap-5"
    >
      <SectionHeader eyebrow={a.favorites_eyebrow} title={a.favorites_title} headingId="fav-title" />
      <div
        role="tablist"
        aria-label={a.favorites_tabs_label}
        class="hidden flex-wrap gap-1 self-start rounded-card-sm border border-line p-1 group-data-ready:flex tablet:gap-1.5 tablet:rounded-full"
      >
        {
          favorites.map((category, index) => (
            <button
              type="button"
              role="tab"
              id={`fav-tab-${category.id}`}
              aria-controls={`fav-panel-${category.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              class="min-h-11 cursor-pointer rounded-full px-[18px] py-2.5 text-[15px] font-medium text-muted transition-colors duration-(--duration-fast) hover:text-fg aria-selected:bg-accent aria-selected:text-ink aria-selected:hover:text-ink"
            >
              {category.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col gap-6">
      {
        favorites.map((category) => (
          <div
            role="tabpanel"
            id={`fav-panel-${category.id}`}
            aria-labelledby={`fav-tab-${category.id}`}
            tabindex="0"
            class="flex flex-col gap-3"
          >
            <h3 class="font-display text-xl font-bold text-fg group-data-ready:sr-only">{category.label}</h3>
            <ul class="grid grid-cols-1 gap-2.5 tablet:grid-cols-2 tablet:gap-3.5 laptop:grid-cols-[repeat(auto-fit,minmax(240px,1fr))] laptop:gap-4">
              {category.items.map((item, i) => (
                <li
                  class="lift animate-fade [animation-fill-mode:backwards] flex items-center gap-4 rounded-card-sm border border-line-subtle bg-surface px-[18px] py-4 tablet:flex-col tablet:items-start tablet:gap-2 tablet:p-[22px] laptop:gap-2.5 laptop:rounded-card laptop:p-6"
                  style={`animation-delay: ${i * 60}ms`}
                >
                  <span class="flex flex-col">
                    <span class="font-display text-[19px] leading-tight font-bold text-fg tablet:text-[22px] tablet:leading-[1.15] laptop:text-2xl">
                      {item.name}
                    </span>
                    {"note" in item && (
                      <span class="text-sm text-muted tablet:mt-2 tablet:text-[15px]">{item.note}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initFavoritesTabs() {
    document.querySelectorAll<HTMLElement>("[data-favorites]").forEach((root) => {
      if (root.hasAttribute("data-ready")) return;
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      if (tabs.length === 0) return;

      const select = (index: number, focus: boolean) => {
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel, i) => {
          panel.hidden = i !== index;
        });
        if (focus) tabs[index].focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index, false));
        tab.addEventListener("keydown", (event) => {
          const last = tabs.length - 1;
          const keyTargets: Record<string, number> = {
            ArrowRight: index === last ? 0 : index + 1,
            ArrowLeft: index === 0 ? last : index - 1,
            Home: 0,
            End: last,
          };
          const target = keyTargets[event.key];
          if (target === undefined) return;
          event.preventDefault();
          select(target, true);
        });
      });

      root.setAttribute("data-ready", "");
      select(0, false);
    });
  }

  document.addEventListener("astro:page-load", initFavoritesTabs);
</script>
