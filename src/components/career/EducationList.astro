---
import IconSchool from "@tabler/icons/outline/school.svg";
import { getMessages } from "../../i18n/utils";

const { educations } = getMessages(Astro.currentLocale).career;
---

<div class="grid min-w-0 gap-4 tablet:grid-cols-2 laptop:gap-5">
  {
    educations.map((education, index) => (
      <article class="lift reveal flex flex-col gap-1.5 rounded-card-sm border border-line-subtle bg-surface p-5 tablet:gap-2 tablet:rounded-[22px] tablet:p-6 laptop:gap-2.5 laptop:rounded-card laptop:p-7">
        <IconSchool
          width={28}
          height={28}
          stroke-width={1.8}
          aria-hidden="true"
          class={index === 0 ? "hidden text-accent laptop:block" : "hidden text-brand laptop:block"}
        />
        <p class="font-mono text-xs text-subtle tablet:text-[13px]">
          {education.date} · {education.institution}
        </p>
        <h3 class="text-lg leading-[1.3] font-semibold text-fg tablet:text-xl laptop:text-[21px]">{education.title}</h3>
        <p class="text-[15px] text-muted laptop:text-base">{education.description}</p>
      </article>
    ))
  }
</div>
