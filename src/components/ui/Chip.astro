---
// Chip de stack (pill).
export interface Props {
  as?: "span" | "li";
  class?: string;
}

const { as: Root = "span", class: className } = Astro.props;
---

<Root
  class:list={[
    "inline-flex items-center rounded-full border border-line bg-surface px-3 py-1.5 text-[15px] text-chip transition-colors duration-(--duration-fast) hover:border-brand",
    className,
  ]}
>
  <slot />
</Root>
